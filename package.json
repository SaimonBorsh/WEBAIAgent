{
  "name": "webaia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Веб-менеджер ИИ-агента на базе opencode",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "start": "npm run start --workspace=server",
    "serve": "node scripts/keepalive.js",
    "backup": "node scripts/backup.js",
    "postinstall": "npm run build --workspace=web"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
